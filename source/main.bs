' Channel entry point. Roku calls Main() automatically on launch.
'
' Project layout
'   source/main.bs                       channel entry
'   components/MainScene.xml/.brs        root Scene
'   components/MovieCard.xml/.brs        one item inside the grid
'   components/MovieFetchTask.xml/.brs   loads data off the render thread
'   assets/movies.json                   movie catalogue (single source of truth)

sub Main()
    print "[Main] channel started"

    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)

    screen.CreateScene("MainScene")
    screen.show()

    ' Block until Roku tells us the screen was closed (user pressed BACK at
    ' the root of MainScene). Without this loop, Main() would return and the
    ' channel would exit immediately.
    while true
        msg = wait(0, port)
        if type(msg) = "roSGScreenEvent" then
            if msg.isScreenClosed() then
                print "[Main] screen closed, exiting"
                return
            end if
        end if
    end while
end sub
