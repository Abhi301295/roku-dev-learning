' Movie — BrighterScript class
'
' BrighterScript adds `class` on top of plain BrightScript.
' Inside class methods, `m` is the instance (like JS `this`).
' Constructor is `sub new(...)`.
'
' BrighterScript                          JavaScript / TypeScript equivalent
' --------------------------------------  -----------------------------------------
' class Movie                             class Movie {
'     public title as string                title: string
'     public year as integer                year: number
'     ...
'     sub new(title as string, ...)         constructor(title: string, ...) {
'         m.title = title                     this.title = title
'     end sub                               }
'
'     function getDisplayTitle() as string  getDisplayTitle(): string {
'         return m.title + " (" + ...         return `${this.title} (${this.year})`
'     end function                          }
' end class                               }
'
' new Movie("Interstellar", 2014, ...)    new Movie("Interstellar", 2014, ...)

class Movie
    public title as string
    public year as integer
    public rating as float
    public durationMins as integer

    sub new(title as string, year as integer, rating as float, durationMins as integer)
        m.title = title
        m.year = year
        m.rating = rating
        m.durationMins = durationMins
    end sub

    function getDisplayTitle() as string
        return m.title + " (" + m.year.ToStr() + ")"
    end function
end class
