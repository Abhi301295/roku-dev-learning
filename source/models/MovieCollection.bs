' MovieCollection — holds Movie instances and exposes aggregate queries.

class MovieCollection
    public movies = []

    sub addMovie(item as Movie)
        m.movies.push(item)
    end sub

    function getHighestRatedMovie() as dynamic
        if m.movies.count() = 0 then return invalid
        highest = m.movies[0]
        for each item in m.movies
            if item.rating > highest.rating then highest = item
        end for
        return highest
    end function

    function getAverageRating() as float
        count = m.movies.count()
        if count = 0 then return 0.0
        total = 0.0
        for each item in m.movies
            total = total + item.rating
        end for
        return total / count
    end function
end class
