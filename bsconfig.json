{
    "rootDir": ".",
    "files": [
        "manifest",
        "source/**/*",
        "components/**/*",
        "images/**/*",
        "!build/**/*",
        "!out/**/*",
        "!node_modules/**/*"
    ],
    "createPackage": false,
    "autoImportComponentScript": false,
    "stagingDir": "build/staging",
    "diagnosticFilters": [
        1129,
        1106
    ]
}
