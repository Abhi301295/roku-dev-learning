<?xml version="1.0" encoding="utf-8" ?>
<!--
  Day 3 / 03 / Exercises 2 & 3 — Consume a Task from a Scene (XML half)

  Runs in: BrightScript Simulator (or real device).

  Architecture this Scene completes:

    HomeScene
        ↓  createObject + observeField + control="RUN"
    MovieTask  (worker thread)
        ↓  loadMovies()
    ContentNode tree on m.top.content
        ↓  onMoviesLoaded
    RowList.content  (UI renders automatically)

  The Task is NOT declared in <children>. Scenes typically create Tasks
  in code so they can start/stop them without cluttering the visual tree.

  Sideload:
    components/HomeScene.xml
    components/HomeScene.brs
    components/tasks/MovieTask.xml   (copy from tasks/1.1 or 1.2 or 1.3)
    components/tasks/MovieTask.brs

  Set this Scene as the channel root in manifest when testing.
-->
<component name="HomeScene" extends="Scene">

    <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />

    <children>
        <Label
            id="statusLabel"
            translation="[80, 60]"
            width="1100"
            horizAlign="left"
            color="0xFFFFFFFF"
            text="Starting Task...">
            <Font role="font" size="28" />
        </Label>

        <!-- RowList reads `content` as a ContentNode tree (topic 02). -->
        <RowList
            id="rowList"
            translation="[80, 120]"
            itemSize="[240, 360]"
            rowItemSize="[[240, 360]]"
            rowItemSpacing="[[24, 0]]"
            itemComponentName="StandardGridItemComponent" />
    </children>

</component>
