<?xml version="1.0" encoding="utf-8" ?>
<!--
  One tile inside MarkupGrid.

  The grid creates one MovieCard per ContentNode and assigns it via the
  built-in `itemContent` field. `focusPercent` animates from 0 to 1 as
  focus enters this card; we use it to fade the focus ring in and out.
-->
<component name="MovieCard" extends="Group">

    <script type="text/brightscript" uri="pkg:/components/MovieCard.brs" />

    <interface>
        <field id="itemContent" type="node" />
        <field id="focusPercent" type="float" />
    </interface>

    <children>
        <!-- 4px border around the card; appears as the focus ring -->
        <Rectangle id="focusRing"
            width="208"
            height="328"
            translation="[-4, -4]"
            color="0xF1C232FF"
            opacity="0" />

        <Rectangle id="cardBackground"
            width="200"
            height="320"
            color="0x1B2030FF" />

        <Poster id="poster"
            uri=""
            width="200"
            height="260"
            loadDisplayMode="scaleToFit" />

        <Label id="titleLabel"
            text=""
            translation="[10, 268]"
            width="180"
            maxLines="1"
            color="0xFFFFFFFF">
            <Font role="font" size="22" />
        </Label>

        <Label id="ratingLabel"
            text=""
            translation="[10, 294]"
            color="0xF1C232FF">
            <Font role="font" size="18" />
        </Label>
    </children>
</component>
