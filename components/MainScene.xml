<?xml version="1.0" encoding="utf-8" ?>
<!--
  Root Scene. The layout is fixed for 1280x720 (HD).

  Node tree (top to bottom in z-order):
    background      full-screen dark backdrop
    titleLabel      page title
    statusLabel     loading / error / "Loaded N movies" message
    loading         spinner shown while the Task is fetching
    movieGrid       horizontal row of MovieCards (focusable)
    hintLabel       remote-control hints at the bottom
    playerLayer     fullscreen video overlay, hidden by default
    movieTask       background loader (invisible, no UI)
-->
<component name="MainScene" extends="Scene">

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Rectangle id="background"
            width="1280"
            height="720"
            color="0x101218FF" />

        <Label id="titleLabel"
            text="Roku Movies"
            translation="[80, 60]"
            color="0xFFFFFFFF">
            <Font role="font" size="56" />
        </Label>

        <Label id="statusLabel"
            text="Loading..."
            translation="[80, 140]"
            color="0x9BB1D6FF">
            <Font role="font" size="28" />
        </Label>

        <BusySpinner id="loading"
            translation="[600, 320]"
            visible="true" />

        <MarkupGrid id="movieGrid"
            translation="[80, 220]"
            itemComponentName="MovieCard"
            numColumns="5"
            numRows="1"
            itemSize="[200, 320]"
            itemSpacing="[30, 0]"
            drawFocusFeedback="false" />

        <Label id="hintLabel"
            text=""
            translation="[80, 660]"
            color="0x9BB1D6FF">
            <Font role="font" size="22" />
        </Label>

        <Group id="playerLayer" visible="false">
            <Rectangle id="playerBackground"
                width="1280"
                height="720"
                color="0x000000FF" />

            <Video id="moviePlayer"
                width="1280"
                height="720"
                enableUI="true"
                enableTrickPlay="true"
                notificationInterval="1" />

            <Label id="playerTitle"
                translation="[40, 30]"
                color="0xFFFFFFFF">
                <Font role="font" size="28" />
            </Label>
        </Group>

        <MovieFetchTask id="movieTask" />
    </children>
</component>
