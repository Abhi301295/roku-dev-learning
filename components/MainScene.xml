<?xml version="1.0" encoding="utf-8" ?>
<!--
  Root Scene.

  bsconfig.json sets `autoImportComponentScript: false`, so the controller
  script must be declared explicitly. The render thread does not see
  source/*.brs unless those files are listed here.
-->
<component name="MainScene" extends="Scene">

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Rectangle id="background"
            width="1280"
            height="720"
            color="0x101218FF" />

        <Label id="titleLabel"
            text="Roku Movies"
            translation="[80, 60]"
            color="0xFFFFFFFF">
            <Font role="font" size="56" />
        </Label>

        <Label id="statusLabel"
            text="Loading..."
            translation="[80, 140]"
            color="0x9BB1D6FF">
            <Font role="font" size="28" />
        </Label>

        <Group id="cardRow"
            translation="[80, 220]" />

        <Label id="hintLabel"
            text=""
            translation="[80, 660]"
            color="0x9BB1D6FF">
            <Font role="font" size="22" />
        </Label>
    </children>
</component>
