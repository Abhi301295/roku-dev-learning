<?xml version="1.0" encoding="utf-8" ?>
<!--
  Background loader. Reads a JSON catalogue and publishes the parsed result
  on the `response` interface field. The parent observes that field and
  reacts when the data is ready.
-->
<component name="MovieFetchTask" extends="Task">

    <script type="text/brightscript" uri="pkg:/components/MovieFetchTask.brs" />

    <interface>
        <field id="url" type="string" />
        <field id="response" type="assocarray" />
    </interface>
</component>
